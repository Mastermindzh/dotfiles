{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://10.10.1.48:11434/v1",
      },
      "models": {
        "qwen3.6-128k": {
          "name": "qwen3.6-128k",
        },
        "qwen3:8b": {
          "name": "qwen3:8b",
        },
        "llama3.2:3b": {
          "name": "llama3.2:3b",
        },
        "qwen2.5-coder:7b": { "name": "qwen2.5-coder:7b" },
        "ornith-1.5:9b": {
          "name": "ornith-1.5:9b",
          // ollama defaults to num_ctx 4096; bump it so larger prompts fit
          "options": {
            "num_ctx": 32768,
          },
        },
      },
    },
  },
  "model": "ollama/ornith-1.5:9b",
  // keep images small enough for local ollama models
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 1000,
      "max_height": 1000,
      "max_base64_bytes": 1048576
    }
  },
}
